<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniquindio.edu.co.cineuqfx.controller.OperadorController"
            prefWidth="1100.0" prefHeight="700.0" styleClass="root-cine">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="header">
            <padding>
                <Insets top="14.0" right="20.0" bottom="14.0" left="20.0"/>
            </padding>
            <children>
                <Label text="CINEMA UQ" styleClass="logo"/>
                <Label text="Panel del operador" styleClass="subtitulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblUsuario" styleClass="subtitulo"/>
                <Button text="Cerrar sesión" styleClass="boton-secundario" onAction="#onCerrarSesion"/>
            </children>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <!-- ===================== CARTELERA ===================== -->
                <Tab text="Cartelera">
                    <content>
                        <BorderPane>
                            <padding>
                                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                            </padding>
                            <top>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <BorderPane.margin>
                                        <Insets bottom="12.0"/>
                                    </BorderPane.margin>
                                    <children>
                                        <Label text="Películas disponibles" styleClass="seccion"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="Actualizar" styleClass="boton-secundario"
                                                onAction="#onActualizarCartelera"/>
                                    </children>
                                </HBox>
                            </top>
                            <center>
                                <TableView fx:id="tablaCartelera">
                                    <columns>
                                        <TableColumn fx:id="colCarCodigo" text="Código" prefWidth="70.0"/>
                                        <TableColumn fx:id="colCarNombre" text="Nombre" prefWidth="260.0"/>
                                        <TableColumn fx:id="colCarGenero" text="Género" prefWidth="160.0"/>
                                        <TableColumn fx:id="colCarDuracion" text="Duración (min)" prefWidth="120.0"/>
                                        <TableColumn fx:id="colCarClasificacion" text="Clasificación" prefWidth="140.0"/>
                                    </columns>
                                </TableView>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>

                <!-- ===================== CLIENTES ====================== -->
                <Tab text="Clientes">
                    <content>
                        <BorderPane>
                            <padding>
                                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                            </padding>
                            <left>
                                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <BorderPane.margin>
                                        <Insets right="16.0"/>
                                    </BorderPane.margin>
                                    <content>
                                        <VBox spacing="8.0" prefWidth="320.0" styleClass="panel">
                                            <padding>
                                                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                                            </padding>
                                            <children>
                                                <Label text="Datos del cliente" styleClass="seccion"/>
                                                <Label text="Identificación"/>
                                                <TextField fx:id="txtCliId" promptText="ej. 1004"/>
                                                <Label text="Nombre"/>
                                                <TextField fx:id="txtCliNombre" promptText="Nombre completo"/>
                                                <Label text="Tipo de cliente"/>
                                                <ComboBox fx:id="cmbCliTipo" maxWidth="Infinity"/>

                                                <!-- Beneficio -->
                                                <Label text="Beneficio asignado:"/>
                                                <ComboBox fx:id="cmbCliBeneficio" maxWidth="Infinity"/>

                                                <!-- Subpanel Membresía -->
                                                <VBox fx:id="boxMembresia" spacing="6.0" style="-fx-background-color: #2a2a38; -fx-padding: 10; -fx-background-radius: 6;">
                                                    <children>
                                                        <Label text="Configurar Membresía" style="-fx-text-fill: #e50914; -fx-font-weight: bold;"/>
                                                        <Label text="Nivel de Membresía:"/>
                                                        <ComboBox fx:id="cmbCliNivelMembresia" maxWidth="Infinity"/>
                                                        <Label text="Puntos iniciales:"/>
                                                        <TextField fx:id="txtCliPuntos" promptText="0"/>
                                                    </children>
                                                </VBox>

                                                <!-- Subpanel Convenio -->
                                                <VBox fx:id="boxConvenio" spacing="6.0" style="-fx-background-color: #2a2a38; -fx-padding: 10; -fx-background-radius: 6;">
                                                    <children>
                                                        <Label text="Configurar Convenio" style="-fx-text-fill: #e50914; -fx-font-weight: bold;"/>
                                                        <Label text="Nombre de la Entidad:"/>
                                                        <TextField fx:id="txtCliEntidad" promptText="ej. Universidad del Quindío"/>
                                                        <Label text="Tipo de Entidad:"/>
                                                        <ComboBox fx:id="cmbCliTipoEntidad" maxWidth="Infinity"/>
                                                        <Label text="Porcentaje de Descuento (%):"/>
                                                        <TextField fx:id="txtCliPorcentajeConvenio" promptText="ej. 20"/>
                                                    </children>
                                                </VBox>

                                                <Button text="Registrar cliente" maxWidth="Infinity" styleClass="boton-primario"
                                                        onAction="#onRegistrarCliente"/>
                                                <Button text="Cambiar tipo del seleccionado" maxWidth="Infinity"
                                                        styleClass="boton-secundario" onAction="#onAscenderCliente"/>
                                                <Button text="Eliminar seleccionado" maxWidth="Infinity"
                                                        styleClass="boton-peligro" onAction="#onEliminarCliente"/>
                                                <Button text="Limpiar" maxWidth="Infinity" styleClass="boton-secundario"
                                                        onAction="#onLimpiarCliente"/>
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </left>
                            <center>
                                <TableView fx:id="tablaClientes">
                                    <columns>
                                        <TableColumn fx:id="colCliId" text="Identificación" prefWidth="120.0"/>
                                        <TableColumn fx:id="colCliNombre" text="Nombre" prefWidth="200.0"/>
                                        <TableColumn fx:id="colCliTipo" text="Tipo" prefWidth="120.0"/>
                                        <TableColumn fx:id="colCliBeneficio" text="Beneficio" prefWidth="240.0"/>
                                    </columns>
                                </TableView>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>

                <!-- ================= VENTA DE ENTRADAS ================= -->
                <Tab text="Venta de Entradas">
                    <content>
                        <BorderPane>
                            <padding>
                                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                            </padding>
                            <center>
                                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <content>
                                        <VBox spacing="14.0" maxWidth="620.0" styleClass="panel">
                                            <padding>
                                                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
                                            </padding>
                                            <children>
                                                <Label text="Taquilla - Registrar Venta de Boletos" styleClass="seccion"/>
                                                
                                                <Label text="Seleccionar Función:"/>
                                                <ComboBox fx:id="cmbVentaFuncion" maxWidth="Infinity" promptText="Selecciona la función deseada"/>

                                                <Label text="Seleccionar Cliente Registrado:"/>
                                                <ComboBox fx:id="cmbVentaCliente" maxWidth="Infinity" promptText="Selecciona el cliente comprador"/>

                                                <Label text="Cantidad de Entradas a Adquirir:"/>
                                                <Spinner fx:id="spnCantidadEntradas" maxWidth="Infinity" editable="true"/>

                                                <Label text="Seleccionar Asiento Inicial / Disponible:"/>
                                                <ComboBox fx:id="cmbVentaAsiento" maxWidth="Infinity" promptText="Elige el asiento inicial"/>
                                                <Label fx:id="lblAsientosAsignados" text="Asientos asignados: (Ninguno)" styleClass="pista" wrapText="true"/>

                                                <!-- Panel Canje de Puntos de Membresía -->
                                                <VBox fx:id="boxCanjePuntos" spacing="6.0" style="-fx-background-color: #232331; -fx-padding: 10; -fx-background-radius: 6;">
                                                    <children>
                                                        <Label fx:id="lblPuntosDisponibles" text="Puntos de Membresía: 0 pts" style="-fx-font-weight: bold; -fx-text-fill: #e50914;"/>
                                                        <CheckBox fx:id="chkUsarPuntos" text="¿Desea utilizar sus puntos de membresía acumulados?" style="-fx-text-fill: #ffffff;"/>
                                                        <Label fx:id="lblInfoCanjePuntos" text="" styleClass="pista" wrapText="true"/>
                                                    </children>
                                                </VBox>

                                                <Label text="Método de Pago:"/>
                                                <ComboBox fx:id="cmbVentaMetodoPago" maxWidth="Infinity" promptText="Selecciona método de pago"/>

                                                <!-- Tarjeta de liquidación -->
                                                <VBox spacing="6.0" style="-fx-background-color: #2a2a38; -fx-padding: 14; -fx-background-radius: 8;">
                                                    <children>
                                                        <Label text="Resumen de liquidación:" style="-fx-font-weight: bold; -fx-text-fill: #e50914;"/>
                                                        <Label fx:id="lblTarifaCliente" text="Tarifa según tipo cliente: $0"/>
                                                        <Label fx:id="lblTotalPagar" text="Total final a pagar: $0" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                                        <Label fx:id="lblInfoMetodo" text="" styleClass="pista" wrapText="true"/>
                                                    </children>
                                                </VBox>

                                                <Button text="🎟️ Procesar y Confirmar Venta" maxWidth="Infinity"
                                                        styleClass="boton-primario" onAction="#onRealizarVenta"/>
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>

                <!-- ================= HISTORIAL DE VENTAS ================= -->
                <Tab text="Historial de Ventas">
                    <content>
                        <BorderPane>
                            <padding>
                                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                            </padding>
                            <top>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <BorderPane.margin>
                                        <Insets bottom="12.0"/>
                                    </BorderPane.margin>
                                    <children>
                                        <Label text="Registro General de Ventas Realizadas" styleClass="seccion"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="Actualizar" styleClass="boton-secundario" onAction="#onActualizarVentas"/>
                                        <Button text="Cancelar Venta Seleccionada" styleClass="boton-peligro" onAction="#onCancelarVenta"/>
                                    </children>
                                </HBox>
                            </top>
                            <center>
                                <TableView fx:id="tablaVentas">
                                    <columns>
                                        <TableColumn fx:id="colVenCodigo" text="Código" prefWidth="90.0"/>
                                        <TableColumn fx:id="colVenCliente" text="Cliente" prefWidth="180.0"/>
                                        <TableColumn fx:id="colVenPelicula" text="Película" prefWidth="180.0"/>
                                        <TableColumn fx:id="colVenSala" text="Sala" prefWidth="100.0"/>
                                        <TableColumn fx:id="colVenAsiento" text="Asiento" prefWidth="80.0"/>
                                        <TableColumn fx:id="colVenFecha" text="Fecha" prefWidth="95.0"/>
                                        <TableColumn fx:id="colVenHora" text="Hora" prefWidth="80.0"/>
                                        <TableColumn fx:id="colVenValor" text="Valor Pagado" prefWidth="110.0"/>
                                        <TableColumn fx:id="colVenEstado" text="Estado" prefWidth="110.0"/>
                                    </columns>
                                </TableView>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </center>
</BorderPane>
